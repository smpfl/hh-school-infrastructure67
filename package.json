{
  "name": "hh-school-infrastructure67",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://smpfl.github.io/hh-school-infrastructure67",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --max-warnings=0 --fix",
    "format": "node scripts/run-prettier.mjs --write --ignore-unknown",
    "format:check": "node scripts/run-prettier.mjs --check --ignore-unknown",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "deploy": "npm run build && gh-pages -d dist",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "gh-pages": "6.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.3.2",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "5.4.21"
  }
}
